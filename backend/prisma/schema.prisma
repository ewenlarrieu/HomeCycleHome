generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model adresse {
  id_adresse         Int           @id @default(autoincrement())
  rue                String        @db.VarChar(50)
  numero_rue         Int           @db.SmallInt
  complement_adresse String?       @db.VarChar(50)
  id_ville           Int
  id_zone            Int
  id_utilisateur     Int
  utilisateur        utilisateur   @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: NoAction, onUpdate: NoAction)
  ville              ville         @relation(fields: [id_ville], references: [id_ville], onDelete: NoAction, onUpdate: NoAction)
  zone               zone          @relation(fields: [id_zone], references: [id_zone], onDelete: NoAction, onUpdate: NoAction)
  rendez_vous        rendez_vous[]
}

model couvre {
  id_utilisateur Int
  id_zone        Int
  utilisateur    utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: NoAction, onUpdate: NoAction)
  zone           zone        @relation(fields: [id_zone], references: [id_zone], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_utilisateur, id_zone])
}

model cycles {
  id_cycle       Int           @id @default(autoincrement())
  marque         String        @db.VarChar(50)
  annee          Int
  commentaire    String?       @db.VarChar(50)
  id_type_cycle  Int
  id_utilisateur Int
  nom            String        @db.VarChar(50)
  type_cycle     type_cycle    @relation(fields: [id_type_cycle], references: [id_type_cycle], onDelete: NoAction, onUpdate: NoAction)
  utilisateur    utilisateur   @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: NoAction, onUpdate: NoAction)
  rendez_vous    rendez_vous[]
}

model disponibilites {
  id_disponibilite Int         @id @default(autoincrement())
  date_debut       DateTime    @db.Timestamp(6)
  date_fin         DateTime    @db.Timestamp(6)
  id_utilisateur   Int
  utilisateur      utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: NoAction, onUpdate: NoAction)
}

model forfait_intervention {
  id_service            Int           @id @default(autoincrement())
  nom_service           String        @unique @db.VarChar(50)
  prix                  Decimal       @db.Decimal(10, 2)
  duree_estimee_minutes Int?
  description           String        @db.VarChar(255)
  rendez_vous           rendez_vous[]
}

model paiement {
  id_paiement     Int             @id @default(autoincrement())
  montant         Decimal         @db.Decimal(10, 2)
  date_paiement   DateTime        @db.Timestamp(6)
  id_status       Int
  id_rendez_vous  Int             @unique
  rendez_vous     rendez_vous     @relation(fields: [id_rendez_vous], references: [id_rendez_vous], onDelete: NoAction, onUpdate: NoAction)
  status_paiement status_paiement @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction)
}

model photos {
  id_photo       Int         @id @default(autoincrement())
  url_photo      String      @unique @db.VarChar(250)
  commentaire    String?     @db.VarChar(50)
  date_ajout     DateTime    @db.Timestamp(6)
  type_photo     String      @db.VarChar(20)
  id_rendez_vous Int
  rendez_vous    rendez_vous @relation(fields: [id_rendez_vous], references: [id_rendez_vous], onDelete: NoAction, onUpdate: NoAction)
}

model produit {
  id_produit          Int                   @id @default(autoincrement())
  nom_produit         String                @unique @db.VarChar(50)
  photo_produit       String?               @db.VarChar(50)
  description         String                @db.VarChar(250)
  quantite            Int
  produit_rendez_vous produit_rendez_vous[]
}

model produit_rendez_vous {
  id_produit_rendez_vous Int         @id @default(autoincrement())
  prix_unitaire          Decimal     @db.Decimal(10, 2)
  quantite               Int
  id_produit             Int
  id_rendez_vous         Int
  produit                produit     @relation(fields: [id_produit], references: [id_produit], onDelete: NoAction, onUpdate: NoAction)
  rendez_vous            rendez_vous @relation(fields: [id_rendez_vous], references: [id_rendez_vous], onDelete: NoAction, onUpdate: NoAction)
}

model rendez_vous {
  id_rendez_vous                                     Int                   @id @default(autoincrement())
  date_rdv                                           DateTime              @db.Timestamp(6)
  commentaire                                        String?               @db.VarChar(50)
  duree_rdv                                          Int
  id_status_rendez_vous                              Int
  id_cycle                                           Int
  id_adresse                                         Int
  id_service                                         Int
  id_client                                          Int?
  id_technicien                                      Int
  paiement                                           paiement?
  photos                                             photos[]
  produit_rendez_vous                                produit_rendez_vous[]
  adresse                                            adresse               @relation(fields: [id_adresse], references: [id_adresse], onDelete: NoAction, onUpdate: NoAction)
  utilisateur_rendez_vous_id_clientToutilisateur     utilisateur?          @relation("rendez_vous_id_clientToutilisateur", fields: [id_client], references: [id_utilisateur], onDelete: NoAction, onUpdate: NoAction)
  cycles                                             cycles                @relation(fields: [id_cycle], references: [id_cycle], onDelete: NoAction, onUpdate: NoAction)
  forfait_intervention                               forfait_intervention  @relation(fields: [id_service], references: [id_service], onDelete: NoAction, onUpdate: NoAction)
  status_rendez_vous                                 status_rendez_vous    @relation(fields: [id_status_rendez_vous], references: [id_status_rendez_vous], onDelete: NoAction, onUpdate: NoAction)
  utilisateur_rendez_vous_id_technicienToutilisateur utilisateur           @relation("rendez_vous_id_technicienToutilisateur", fields: [id_technicien], references: [id_utilisateur], onDelete: NoAction, onUpdate: NoAction)
}

model role {
  id_role     Int           @id @default(autoincrement())
  libelle     String        @unique @db.VarChar(50)
  utilisateur utilisateur[]
}

model societe {
  id_societe  Int    @id @default(autoincrement())
  nom_societe String @unique @db.VarChar(50)
  telephone   String @unique @db.VarChar(50)
  email       String @unique @db.VarChar(50)
  adresse     String @db.VarChar(50)
  ville       String @db.VarChar(50)
  code_postal String @db.VarChar(50)
}

model status_compte {
  id_status   Int           @id @default(autoincrement())
  libelle     String        @db.VarChar(50)
  utilisateur utilisateur[]
}

model status_paiement {
  id_status Int        @id @default(autoincrement())
  libelle   String     @db.VarChar(50)
  paiement  paiement[]
}

model status_rendez_vous {
  id_status_rendez_vous Int           @id @default(autoincrement())
  libelle               String        @db.VarChar(50)
  rendez_vous           rendez_vous[]
}

model type_cycle {
  id_type_cycle Int      @id @default(autoincrement())
  libelle       String   @db.VarChar(50)
  cycles        cycles[]
}

model utilisateur {
  id_utilisateur                                     Int              @id @default(autoincrement())
  nom                                                String           @db.VarChar(50)
  prenom                                             String           @db.VarChar(50)
  email                                              String           @unique @db.VarChar(150)
  mot_de_passe                                       String           @db.VarChar(255)
  telephone                                          String           @unique @db.VarChar(50)
  date_creation                                      DateTime         @db.Timestamp(6)
  id_status                                          Int
  id_role                                            Int
  adresse                                            adresse[]
  couvre                                             couvre[]
  cycles                                             cycles[]
  disponibilites                                     disponibilites[]
  rendez_vous_rendez_vous_id_clientToutilisateur     rendez_vous[]    @relation("rendez_vous_id_clientToutilisateur")
  rendez_vous_rendez_vous_id_technicienToutilisateur rendez_vous[]    @relation("rendez_vous_id_technicienToutilisateur")
  role                                               role             @relation(fields: [id_role], references: [id_role], onDelete: NoAction, onUpdate: NoAction)
  status_compte                                      status_compte    @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction)
}

model ville {
  id_ville    Int       @id @default(autoincrement())
  nom_ville   String    @db.VarChar(50)
  code_postal String    @db.VarChar(50)
  adresse     adresse[]
}

model zone {
  id_zone     Int       @id @default(autoincrement())
  nom_zone    String    @db.VarChar(50)
  code_postal String    @db.VarChar(50)
  adresse     adresse[]
  couvre      couvre[]
}
